#include <stdio.h>

int main() {
    float balance = 500.00;
    int choice;
    float amount;

    do {
        printf("\nBSIT BANK\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                printf("Your current balance: P%.2f\n", balance);
                break;

            case 2:
                printf("Enter amount to deposit: ");
                scanf("%f", &amount);
                balance = balance + amount;
                printf("P%.2f deposited successfully!\n", amount);
                break;

            case 3:
                printf("Enter amount to withdraw: ");
                scanf("%f", &amount);
                if ((balance - amount) < 100.00) {
                    printf("Withdrawal denied! You must maintain at least P100.00 in your account\n");
                } else {
                    balance = balance - amount;
                    printf("You withdrew P%.2f successfully!\n", amount);
                }
                break;

            case 4:
                printf("Thank you for using BSIT BANK!\n");
                break;

            default:
                printf("Invalid choice. Please try again.\n");
        }

    } while (choice != 4);

    return 0;
}
